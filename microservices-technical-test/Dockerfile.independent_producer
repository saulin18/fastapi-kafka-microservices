FROM python:3.13 AS base

WORKDIR /app

RUN pip install uv

FROM base AS builder

WORKDIR /app

COPY independent_producer/pyproject.toml independent_producer/uv.lock ./
COPY independent_producer .
RUN uv sync --frozen


FROM base AS runtime

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app .

RUN groupadd -g 1234 independent_producer && \
    useradd -m -u 1234 -g independent_producer independent_producer

RUN chown -R independent_producer:independent_producer /app

USER independent_producer

EXPOSE 8001

# API by default. Same image, other service/CMD for the worker, e.g.:
#   celery -A ioc.celery_app worker -B -l info
CMD ["/app/.venv/bin/uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]